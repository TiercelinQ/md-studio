<UserControl
    x:Class="MdStudio.Views.Layout.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:MdStudio.Resources">
    <!-- Zone H: C-24 status bar, C-17 badge, C-22 zoom control -->
    <Border Style="{StaticResource StatusBarStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Border Style="{StaticResource ModifiedBadgeStyle}" Visibility="{Binding ActiveDocument.IsModified, Converter={StaticResource BooleanToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource BadgeTextStyle}" Text="{x:Static res:Strings.Status_Modified}" />
                </Border>
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ModeText}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ActiveDocument.WordCountText}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ActiveDocument.EncodingText}" />
                <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ActiveDocument.LineEndingText}" />
                <StackPanel Style="{StaticResource ZoomGroupStyle}">
                    <Button AutomationProperties.Name="{x:Static res:Strings.Zoom_Out}" Command="{Binding ZoomOutCommand}" Style="{StaticResource ZoomButtonStyle}" ToolTip="{x:Static res:Strings.Zoom_Out}">
                        <ContentControl Style="{StaticResource IconMiniStyle}" Tag="{StaticResource IconMinusGeometry}" />
                    </Button>
                    <Button Command="{Binding ZoomResetCommand}" Content="{Binding ZoomText}" Style="{StaticResource ZoomButtonStyle}" ToolTip="{x:Static res:Strings.Zoom_Reset}" />
                    <Button AutomationProperties.Name="{x:Static res:Strings.Zoom_In}" Command="{Binding ZoomInCommand}" Style="{StaticResource ZoomButtonStyle}" ToolTip="{x:Static res:Strings.Zoom_In}">
                        <ContentControl Style="{StaticResource IconMiniStyle}" Tag="{StaticResource IconPlusGeometry}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource StatusPathStyle}" Text="{Binding ActiveDocument.FilePath}" />
        </DockPanel>
    </Border>
</UserControl>
