<UserControl
    x:Class="MdStudio.Views.Dialogs.LinkDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:MdStudio.Resources">
    <!-- Content of the link dialog (C-19 body), bound to LinkDialogViewModel -->
    <StackPanel Style="{StaticResource DialogFormStyle}">
        <TextBlock Style="{StaticResource DialogLabelStyle}" Text="{x:Static res:Strings.Link_Label}" />
        <TextBox
            x:Name="UrlBox"
            AutomationProperties.Name="{x:Static res:Strings.Link_Label}"
            Style="{StaticResource DialogTextBoxStyle}"
            Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
