<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORS -->
    <Color x:Key="ChromeColor">#FF171A1E</Color>
    <Color x:Key="BarColor">#FF25282C</Color>
    <Color x:Key="PaneColor">#FF1F2226</Color>
    <Color x:Key="DocColor">#FF2A2D31</Color>
    <Color x:Key="FgColor">#FFF2F3F5</Color>
    <Color x:Key="Fg2Color">#FFC6C9CE</Color>
    <Color x:Key="Fg3Color">#FF9CA1A9</Color>
    <Color x:Key="StrokeColor">#FF383C42</Color>
    <Color x:Key="Stroke2Color">#FF4A4F56</Color>
    <Color x:Key="HoverColor">#0FFFFFFF</Color>
    <Color x:Key="PressColor">#1AFFFFFF</Color>
    <Color x:Key="AccentColor">#FF60CDFF</Color>
    <Color x:Key="OnAccentColor">#FF00131C</Color>
    <Color x:Key="AccentTextColor">#FF60CDFF</Color>
    <Color x:Key="AccentSoftColor">#2460CDFF</Color>
    <Color x:Key="FolderColor">#FFE8B84A</Color>
    <Color x:Key="CodeBgColor">#FF1E2124</Color>
    <Color x:Key="SynKColor">#FF79C0FF</Color>
    <Color x:Key="SynSColor">#FF7EE2A8</Color>
    <Color x:Key="SynCColor">#FF9CA1A9</Color>
    <Color x:Key="MarkColor">#FF6B5A12</Color>
    <Color x:Key="MarkCurColor">#FFA85F10</Color>
    <Color x:Key="MarkFgColor">#FFFFFFFF</Color>
    <Color x:Key="DangerColor">#FFFF99A4</Color>
    <Color x:Key="CloseHoverColor">#FFC42B1C</Color>

    <!-- BRUSHES -->
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="BarBrush" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="PaneBrush" Color="{StaticResource PaneColor}" />
    <SolidColorBrush x:Key="DocBrush" Color="{StaticResource DocColor}" />
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="Fg2Brush" Color="{StaticResource Fg2Color}" />
    <SolidColorBrush x:Key="Fg3Brush" Color="{StaticResource Fg3Color}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="{StaticResource Stroke2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressBrush" Color="{StaticResource PressColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="FolderBrush" Color="{StaticResource FolderColor}" />
    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}" />
    <SolidColorBrush x:Key="SynKBrush" Color="{StaticResource SynKColor}" />
    <SolidColorBrush x:Key="SynSBrush" Color="{StaticResource SynSColor}" />
    <SolidColorBrush x:Key="SynCBrush" Color="{StaticResource SynCColor}" />
    <SolidColorBrush x:Key="MarkBrush" Color="{StaticResource MarkColor}" />
    <SolidColorBrush x:Key="MarkCurBrush" Color="{StaticResource MarkCurColor}" />
    <SolidColorBrush x:Key="MarkFgBrush" Color="{StaticResource MarkFgColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />

    <!-- WPF UI ALIASES -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Fg2Color}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Fg3Color}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Stroke2Color}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PaneColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource DocColor}" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource DocColor}" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource PaneColor}" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000" />

    <!-- FIXED VALUES (same in both themes, specification 5.2) -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="WindowCloseForegroundBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
