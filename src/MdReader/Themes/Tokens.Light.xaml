    <SolidColorBrush x:Key="MarkFgBrush" Color="{StaticResource MarkFgColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />

    <!-- WPF UI ALIASES -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Fg2Color}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Fg3Color}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Stroke2Color}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PaneColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource DocColor}" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="{StaticResource DocColor}" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource PaneColor}" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#66000000" />

    <!-- FIXED VALUES (same in both themes, specification 5.2) -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="WindowCloseForegroundBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
