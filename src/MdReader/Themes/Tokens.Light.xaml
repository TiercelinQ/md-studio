    <Color x:Key="PaneColor">#FFF1F2F4</Color>
    <Color x:Key="DocColor">#FFFFFFFF</Color>
    <Color x:Key="FgColor">#FF1A1C1F</Color>
    <Color x:Key="Fg2Color">#FF4B5058</Color>
    <Color x:Key="Fg3Color">#FF5F6570</Color>
    <Color x:Key="StrokeColor">#FFE0E2E6</Color>
    <Color x:Key="Stroke2Color">#FFC9CCD2</Color>
    <Color x:Key="HoverColor">#0F141E2D</Color>
    <Color x:Key="PressColor">#1A141E2D</Color>
    <Color x:Key="AccentColor">#FF0067C0</Color>
