    <Color x:Key="SynCColor">#FF6A707A</Color>
    <Color x:Key="MarkColor">#FFFFF0A0</Color>
    <Color x:Key="MarkCurColor">#FFFFB454</Color>
    <Color x:Key="MarkFgColor">#FF1A1C1F</Color>
    <Color x:Key="DangerColor">#FFC42B1C</Color>
    <Color x:Key="CloseHoverColor">#FFC42B1C</Color>

    <!-- BRUSHES -->
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="BarBrush" Color="{StaticResource BarColor}" />
    <SolidColorBrush x:Key="PaneBrush" Color="{StaticResource PaneColor}" />
    <SolidColorBrush x:Key="DocBrush" Color="{StaticResource DocColor}" />
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="Fg2Brush" Color="{StaticResource Fg2Color}" />
    <SolidColorBrush x:Key="Fg3Brush" Color="{StaticResource Fg3Color}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="{StaticResource Stroke2Color}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressBrush" Color="{StaticResource PressColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="FolderBrush" Color="{StaticResource FolderColor}" />
    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}" />
    <SolidColorBrush x:Key="SynKBrush" Color="{StaticResource SynKColor}" />
    <SolidColorBrush x:Key="SynSBrush" Color="{StaticResource SynSColor}" />
    <SolidColorBrush x:Key="SynCBrush" Color="{StaticResource SynCColor}" />
    <SolidColorBrush x:Key="MarkBrush" Color="{StaticResource MarkColor}" />
