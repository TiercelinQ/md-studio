<Project>
  <!--
    Portable distribution (rules/packaging.md): one self-contained executable, no installer.
    Command (application closed, project path mandatory):
      dotnet publish src/MdReader -c Release -p:PublishProfile=win-x64
  -->
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- No .NET runtime to install on the target machine. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF native libraries inside the executable, otherwise they stay loose next to it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Faster cold start, larger binary. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF is not trim-safe (reflection over XAML types). Never set to true. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The published folder holds the executable and nothing else. -->
    <DebugType>none</DebugType>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
