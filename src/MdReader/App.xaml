<Application
    x:Class="MdReader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:MdReader.ViewModels"
    xmlns:dialogs="clr-namespace:MdReader.Views.Dialogs"
    ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: the composition root decides what to show (App.xaml.cs). -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge order (rules/xaml.md): Fluent dictionaries first, then the project overrides. -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Content of the link dialog (deviation E-14) -->
            <DataTemplate DataType="{x:Type vm:LinkDialogViewModel}">
                <dialogs:LinkDialogContent />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
