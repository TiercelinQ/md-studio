<UserControl
    x:Class="MdReader.Views.Layout.CommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:MdReader.Resources">
    <!-- Zone B: C-01 command buttons, C-02 segmented control, C-03 separators, C-04 tool buttons -->
    <Border Style="{StaticResource CommandBarStyle}">
        <Grid Style="{StaticResource CommandBarLayoutStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Style="{StaticResource CommandGroupStyle}">
                <Button
                    AutomationProperties.Name="{x:Static res:Strings.Command_CreateFile}"
                    Command="{Binding CreateFileCommand}"
                    Style="{StaticResource CommandButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_CreateFile_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconAccentStyle}" Tag="{StaticResource IconFileNewGeometry}" />
                        <TextBlock Style="{StaticResource CommandLabelStyle}" Text="{x:Static res:Strings.Command_CreateFile}" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="{x:Static res:Strings.Command_OpenFile}"
                    Command="{Binding OpenFileCommand}"
                    Style="{StaticResource CommandButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_OpenFile_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconAccentStyle}" Tag="{StaticResource IconFileGeometry}" />
                        <TextBlock Style="{StaticResource CommandLabelStyle}" Text="{x:Static res:Strings.Command_OpenFile}" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="{x:Static res:Strings.Command_OpenFolder}"
                    Command="{Binding OpenFolderCommand}"
                    Style="{StaticResource CommandButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_OpenFolder_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconAccentStyle}" Tag="{StaticResource IconFolderGeometry}" />
                        <TextBlock Style="{StaticResource CommandLabelStyle}" Text="{x:Static res:Strings.Command_OpenFolder}" />
                    </StackPanel>
                </Button>
                <Separator Style="{StaticResource CommandSeparatorStyle}" />
                <Button
                    AutomationProperties.Name="{x:Static res:Strings.Command_Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource CommandButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_Save_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconSaveGeometry}" />
                        <TextBlock Style="{StaticResource CommandLabelStyle}" Text="{x:Static res:Strings.Command_Save}" />
                    </StackPanel>
                </Button>
                <Separator Style="{StaticResource CommandSeparatorStyle}" />
                <Border AutomationProperties.Name="{x:Static res:Strings.Mode_Group}" Style="{StaticResource SegmentContainerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            AutomationProperties.Name="{x:Static res:Strings.Mode_Reading}"
                            GroupName="Mode"
                            IsChecked="{Binding IsReading, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}"
                            Style="{StaticResource SegmentRadioStyle}"
                            ToolTip="{x:Static res:Strings.Mode_Reading_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconEyeGeometry}" />
                                <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="{x:Static res:Strings.Mode_Reading}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            AutomationProperties.Name="{x:Static res:Strings.Mode_Editing}"
                            GroupName="Mode"
                            IsChecked="{Binding IsEditing, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}"
                            Style="{StaticResource SegmentRadioStyle}"
                            ToolTip="{x:Static res:Strings.Mode_Editing_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconEditGeometry}" />
                                <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="{x:Static res:Strings.Mode_Editing}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            AutomationProperties.Name="{x:Static res:Strings.Mode_Source}"
                            GroupName="Mode"
                            IsChecked="{Binding IsSource, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}"
                            Style="{StaticResource SegmentRadioStyle}"
                            ToolTip="{x:Static res:Strings.Mode_Source_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconCodeGeometry}" />
                                <TextBlock Style="{StaticResource SegmentLabelStyle}" Text="{x:Static res:Strings.Mode_Source}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Style="{StaticResource CommandRightGroupStyle}">
                <Button
                    AutomationProperties.Name="{x:Static res:Strings.Command_Search_Name}"
                    Command="{Binding OpenSearchCommand}"
                    Style="{StaticResource CommandIconButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_Search_Tooltip}">
                    <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconSearchGeometry}" />
                </Button>
                <ToggleButton
                    AutomationProperties.Name="{x:Static res:Strings.Command_Explorer_Name}"
                    IsChecked="{Binding ExplorerToggle, Mode=TwoWay}"
                    Style="{StaticResource CommandToggleButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_Explorer_Tooltip}">
                    <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconSideLeftGeometry}" />
                </ToggleButton>
                <ToggleButton
                    AutomationProperties.Name="{x:Static res:Strings.Command_Outline_Name}"
                    IsChecked="{Binding OutlineToggle, Mode=TwoWay}"
                    Style="{StaticResource CommandToggleButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_Outline_Tooltip}">
                    <ContentControl Style="{StaticResource IconStyle}" Tag="{StaticResource IconSideRightGeometry}" />
                </ToggleButton>
                <Separator Style="{StaticResource CommandSeparatorStyle}" />
                <Button
                    AutomationProperties.Name="{x:Static res:Strings.Command_Theme_Name}"
                    Command="{Binding ToggleThemeCommand}"
                    Style="{StaticResource CommandIconButtonStyle}"
                    ToolTip="{x:Static res:Strings.Command_Theme_Tooltip}">
                    <ContentControl Style="{StaticResource ThemeIconStyle}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
