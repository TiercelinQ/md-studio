<UserControl
    x:Class="MdReader.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:MdReader.Views.Controls"
    xmlns:views="clr-namespace:MdReader.Views"
    xmlns:res="clr-namespace:MdReader.Resources">
    <!-- Zone F: C-14 breadcrumb and search, disk banner (deviation E-07), document page, loading screen, C-25 empty state -->
    <Grid Style="{StaticResource DocumentAreaStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DocumentHeaderStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Style="{StaticResource SearchBarStyle}">
                    <Grid>
                        <TextBox
                            x:Name="SearchBox"
                            AutomationProperties.Name="{x:Static res:Strings.Search_Name}"
                            Style="{StaticResource SearchTextBoxStyle}"
                            Text="{Binding ActiveDocument.SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ActiveDocument.SearchNextCommand}" />
                                <KeyBinding Key="Enter" Command="{Binding ActiveDocument.SearchPreviousCommand}" Modifiers="Shift" />
                                <KeyBinding Key="Escape" Command="{Binding ActiveDocument.CloseSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource SearchPlaceholderStyle}" Text="{x:Static res:Strings.Search_Placeholder}" />
                    </Grid>
                    <TextBlock Style="{StaticResource SearchCounterStyle}" Text="{Binding ActiveDocument.SearchCounterText}" />
                    <Button AutomationProperties.Name="{x:Static res:Strings.Search_Previous}" Command="{Binding ActiveDocument.SearchPreviousCommand}" Style="{StaticResource ToolButtonSmallStyle}" ToolTip="{x:Static res:Strings.Search_Previous_Tooltip}">
                        <ContentControl Style="{StaticResource IconSmallStyle}" Tag="{StaticResource IconChevronUpGeometry}" />
                    </Button>
                    <Button AutomationProperties.Name="{x:Static res:Strings.Search_Next}" Command="{Binding ActiveDocument.SearchNextCommand}" Style="{StaticResource ToolButtonSmallStyle}" ToolTip="{x:Static res:Strings.Search_Next_Tooltip}">
                        <ContentControl Style="{StaticResource IconSmallStyle}" Tag="{StaticResource IconChevronDownGeometry}" />
                    </Button>
                    <Button AutomationProperties.Name="{x:Static res:Strings.Search_Close}" Command="{Binding ActiveDocument.CloseSearchCommand}" Style="{StaticResource ToolButtonSmallStyle}" ToolTip="{x:Static res:Strings.Search_Close_Tooltip}">
                        <ContentControl Style="{StaticResource IconSmallStyle}" Tag="{StaticResource IconCloseGeometry}" />
                    </Button>
                </StackPanel>
                <StackPanel AutomationProperties.Name="{x:Static res:Strings.Breadcrumb_Name}" Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding ActiveDocument.Breadcrumb}" Style="{StaticResource BreadcrumbFoldersStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource BreadcrumbTextStyle}" Text="{Binding}" />
                                    <ContentControl Style="{StaticResource BreadcrumbChevronStyle}" Tag="{StaticResource IconChevronRightGeometry}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource BreadcrumbFileStyle}" Text="{Binding ActiveDocument.FileName}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource DiskBannerStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding ActiveDocument.ReloadFromDiskCommand}" Content="{x:Static res:Strings.Banner_Reload}" Style="{StaticResource BannerButtonStyle}" Visibility="{Binding ActiveDocument.CanReload, Converter={StaticResource BooleanToVisibility}}" />
                    <Button Command="{Binding ActiveDocument.KeepMyVersionCommand}" Content="{x:Static res:Strings.Banner_Keep}" Style="{StaticResource BannerButtonStyle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource BannerTextStyle}" Text="{Binding ActiveDocument.DiskBannerText}" />
            </DockPanel>
        </Border>

        <controls:DocumentHost Grid.Row="2" Style="{StaticResource DocumentHostStyle}" />
        <Grid Grid.Row="2" AutomationProperties.Name="{x:Static res:Strings.Loading_Document}" Style="{StaticResource LoadingStateStyle}">
            <StackPanel Style="{StaticResource LoadingContentStyle}">
                <ui:ProgressRing Style="{StaticResource LoadingRingStyle}" />
                <TextBlock Style="{StaticResource LoadingTextStyle}" Text="{x:Static res:Strings.Loading_Document}" />
            </StackPanel>
        </Grid>
        <views:EmptyStateView Grid.Row="2" Visibility="{Binding HasNoDocument, Converter={StaticResource BooleanToVisibility}}" />
    </Grid>
</UserControl>
